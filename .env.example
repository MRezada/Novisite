# رمز ورود به پنل مدیریت (/admin) — حتماً یک رمز قوی بگذارید
ADMIN_PASSWORD=یک-رمز-قوی-بنویسید
# کلید امضای نشست ادمین؛ یک رشته‌ی تصادفی طولانی (اختیاری ولی توصیه می‌شود)
ADMIN_SECRET=
# آدرس نهایی سایت (می‌توانید از پنل ← تنظیمات هم تغییر دهید)
NEXT_PUBLIC_SITE_URL=https://novisoft.dev
# مسیر ذخیره‌ی داده‌ها و تصاویر آپلودشده (پیش‌فرض: پوشه‌ی data کنار پروژه)
# DATA_DIR=/var/lib/novisoft
